# Copy to .env for local (non-docker) development. docker-compose sets its own.
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
RAG_REDIS_URL=redis://localhost:6379/0
RAG_ENVIRONMENT=dev
RAG_LOG_LEVEL=INFO

# Providers (ADR 0001). fake = deterministic, zero downloads/keys (tests, CI, offline dev)
RAG_LLM_PROVIDER=anthropic
RAG_ANTHROPIC_API_KEY=            # required iff RAG_LLM_PROVIDER=anthropic
RAG_EMBEDDING_PROVIDER=local      # 'local' downloads bge-small (~130MB) on first use
RAG_RERANKER=none                 # none | cross_encoder | fake  (ADR 0003)

# Auth (ADR 0004) — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RAG_JWT_SECRET=
